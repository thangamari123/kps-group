rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH & AUTHORIZATION HELPERS
    // ============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive != false;
    }

    // ============================================================
    // ADMINS COLLECTION
    // ============================================================
    // Authenticated admins can read their own record or other records if authorized.
    // Client write operations blocked (provisioned through Firebase Console/Admin SDK).
    match /admins/{adminUid} {
      allow read: if isAuthenticated() && (request.auth.uid == adminUid || isAdmin());
      allow write: if false;
    }

    // ============================================================
    // CMS: GALLERY COLLECTION
    // ============================================================
    // Public can read published gallery items.
    // Authorized active admins can perform full CRUD.
    match /gallery/{galleryId} {
      allow read: if (resource != null && resource.data.status == 'published') || isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // CMS: BLOGS COLLECTION
    // ============================================================
    // Public can read published blog articles.
    // Authorized active admins can perform full CRUD.
    match /blogs/{blogId} {
      allow read: if (resource != null && resource.data.status == 'published') || isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // CMS: CSR COLLECTION
    // ============================================================
    // Public can read published CSR sections.
    // Authorized active admins can perform full CRUD.
    match /csr/{sectionId} {
      allow read: if (resource != null && resource.data.status == 'published') || isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // CMS: AWARDS COLLECTION
    // ============================================================
    // Public can read published awards & honors.
    // Authorized active admins can perform full CRUD.
    match /awards/{awardId} {
      allow read: if (resource != null && resource.data.status == 'published') || isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // CAREERS & JOBS
    // ============================================================
    match /jobs/{jobId} {
      allow read: if (resource != null && (resource.data.status == 'published' || resource.data.status == 'active')) || isAdmin();
      allow write: if isAdmin();
    }

    match /applications/{applicationId} {
      allow create: if request.resource.data.jobId is string &&
                       request.resource.data.candidateName is string &&
                       request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    // ============================================================
    // QUOTES & INQUIRIES
    // ============================================================
    match /quotes/{quoteId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ============================================================
    // ACTIVITY LOGS
    // ============================================================
    match /activity_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
