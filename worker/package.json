{
  "name": "kps-backend-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply kps-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kps-db --remote",
    "db:seed:local": "wrangler d1 execute kps-db --local --file=./migrations/0002_seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240923.0",
    "typescript": "^5.6.2",
    "wrangler": "^3.78.6"
  }
}
