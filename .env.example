# KPS Worldwide Logistics - Frontend Environment Configuration

# Backend Cloudflare Worker API URL (defaults to http://localhost:8787 in local development)
NEXT_PUBLIC_API_URL=http://localhost:8787

# Firebase Web SDK Configuration (Project: KPS Website HR Panel)
# Copy these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
